# Alamat backend NestJS, sudah termasuk awalan /api.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# App key dari POST /api/maker/register. Boleh dikosongkan: bila kosong, header
# x-maker-key tidak dikirim dan backend memakai maker bawaan.
NEXT_PUBLIC_APP_KEY=

# Harus sama dengan JAM_OPERASIONAL_BUKA dan JAM_OPERASIONAL_TUTUP di backend.
# Dipakai membatasi pilihan jam pada form; penolakan sebenarnya tetap di backend.
NEXT_PUBLIC_JAM_BUKA=07:00
NEXT_PUBLIC_JAM_TUTUP=22:00
