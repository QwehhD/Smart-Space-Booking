          },
          "telp": {
            "type": "string",
            "example": "081298765432"
          },
          "alamat": {
            "type": "string",
            "example": "Jl. Danau Ranau No. 1, Malang"
          },
          "deskripsi": {
            "type": "string",
            "example": "Coworking space 3 lantai dengan WiFi 100 Mbps dan area parkir luas."
          },
          "foto": {
            "type": "string",
            "example": "moklet_hub.jpg"
          }
        },
        "required": [
          "username",
          "password",
          "nama_coworking",
          "nama_pemilik",
          "telp"
        ]
      },
