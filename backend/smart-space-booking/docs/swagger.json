        "type": "http",
        "description": "Tempelkan access_token hasil login tanpa awalan \"Bearer\""
      }
    },
    "schemas": {
      "RegisterMemberDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "johndoe"
          },
          "password": {
            "type": "string",
            "example": "Secret123!"
          },
          "nama_member": {
            "type": "string",
            "example": "John Doe"
          },
          "instansi": {
            "type": "string",
            "example": "Universitas Indonesia / PT Maju Mundur"
          },
          "alamat": {
            "type": "string",
            "example": "Jl. Sudirman No. 123, Jakarta Selatan"
          },
          "telp": {
            "type": "string",
            "example": "081234567890"
          },
          "foto": {
            "type": "string",
            "example": "member_john.jpg",
            "description": "Nama file hasil unggah dari POST /api/upload/members"
          }
        },
        "required": [
          "username",
          "password",
          "nama_member",
          "instansi",
          "alamat",
          "telp"
        ]
      },
      "RegisterAdminSpaceDto": {
        "type": "object",
