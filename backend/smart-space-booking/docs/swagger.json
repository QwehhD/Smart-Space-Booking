  "info": {
    "title": "Smart Space Booking API",
    "description": "REST API sistem reservasi coworking space untuk UKK RPL 2026/2027 Paket B. Mencakup autentikasi multi-role, katalog space, kode promo, reservasi, e-ticket ber-QR, check-in/check-out, serta rekapitulasi pendapatan bulanan.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
