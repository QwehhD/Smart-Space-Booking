generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin_space
  member
}

enum TipeSpace {
  desk
  meeting_room
  private_office
}

enum StatusReservasi {
  belum_dikonfirm
  disetujui
  aktif
  selesai
  dibatalkan
}

model User {
  id         Int      @id @default(autoincrement())
  username   String   @unique @db.VarChar(50)
  password   String   @db.VarChar(255)
  role       Role
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  member      Member?
  space_owner SpaceOwner?

  @@map("users")
}

model Member {
  id          Int       @id @default(autoincrement())
  nama_member String    @db.VarChar(100)
  instansi    String    @db.VarChar(100)
  alamat      String    @db.Text
  telp        String    @db.VarChar(20)
  foto        String?   @db.VarChar(255)
  id_user     Int       @unique
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  user      User        @relation(fields: [id_user], references: [id], onDelete: Cascade)
  reservasi Reservasi[]

  @@index([deleted_at])
  @@map("member")
}

model SpaceOwner {
  id             Int      @id @default(autoincrement())
  nama_coworking String   @db.VarChar(100)
  nama_pemilik   String   @db.VarChar(100)
  telp           String   @db.VarChar(20)
  alamat         String?  @db.Text
  deskripsi      String?  @db.Text
  foto           String?  @db.VarChar(255)
  id_user        Int      @unique
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user      User        @relation(fields: [id_user], references: [id], onDelete: Cascade)
  space     Space[]
  diskon    Diskon[]
  reservasi Reservasi[]

  @@map("space_owner")
}

model Space {
  id            Int       @id @default(autoincrement())
  nama_space    String    @db.VarChar(100)
  harga_per_jam Int
  tipe          TipeSpace
  kapasitas     Int
  foto          String?   @db.VarChar(255)
  deskripsi     String    @db.Text
  id_owner      Int
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  owner            SpaceOwner        @relation(fields: [id_owner], references: [id])
  detail_reservasi DetailReservasi[]

  @@index([id_owner])
  @@index([tipe])
  @@index([deleted_at])
  @@map("space")
}

model Diskon {
  id                Int       @id @default(autoincrement())
  nama_diskon       String    @db.VarChar(100)
  persentase_diskon Int
  tanggal_awal      DateTime
  tanggal_akhir     DateTime
  id_owner          Int
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  deleted_at        DateTime?

  owner            SpaceOwner        @relation(fields: [id_owner], references: [id])
  detail_reservasi DetailReservasi[]

  @@unique([id_owner, nama_diskon])
  @@index([tanggal_awal, tanggal_akhir])
  @@map("diskon")
}

model Reservasi {
  id                Int             @id @default(autoincrement())
  kode_booking      String          @unique @db.VarChar(30)
  tanggal_reservasi DateTime        @db.Date
  jam_mulai         String          @db.VarChar(5)
  jam_selesai       String          @db.VarChar(5)
  durasi_jam        Int
  id_owner          Int
  id_member         Int
  status            StatusReservasi @default(belum_dikonfirm)
  check_in_time     DateTime?
  check_out_time    DateTime?
  catatan_batal     String?         @db.VarChar(255)
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  owner  SpaceOwner       @relation(fields: [id_owner], references: [id])
  member Member           @relation(fields: [id_member], references: [id])
  detail DetailReservasi?

  @@index([tanggal_reservasi, status])
  @@index([id_owner, tanggal_reservasi])
  @@index([id_member])
  @@map("reservasi")
}

model DetailReservasi {
  id                Int  @id @default(autoincrement())
  id_reservasi      Int  @unique
  id_space          Int
  id_diskon         Int?
  harga_per_jam     Int
  total_harga_awal  Int
  persentase_diskon Int  @default(0)
  potongan_diskon   Int  @default(0)
  total_harga       Int

  reservasi Reservasi @relation(fields: [id_reservasi], references: [id], onDelete: Cascade)
  space     Space     @relation(fields: [id_space], references: [id])
  diskon    Diskon?   @relation(fields: [id_diskon], references: [id])

  @@index([id_space])
  @@index([id_diskon])
  @@map("detail_reservasi")
}
